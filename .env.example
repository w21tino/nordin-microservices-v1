# ═══════════════════════════════════════════════════════
# nordin-microservices-v1 — Variables de entorno
#
# Copia este archivo como .env y ajusta los valores
# NUNCA subas .env a GitHub
# ═══════════════════════════════════════════════════════

# Config Server
CONFIG_USER=config-user
CONFIG_PASS=config-pass
CONFIG_HOST=localhost

# Eureka Server
EUREKA_USER=eureka-user
EUREKA_PASS=eureka-pass
EUREKA_HOST=localhost

# Admin Server
ADMIN_USER=admin-user
ADMIN_PASS=admin-pass

# JWT
JWT_SECRET=nordin-secret-key-para-desarrollo-minimo-256-bits-aqui

# Grafana
GRAFANA_USER=admin
GRAFANA_PASS=admin

# GitHub Config Repo
GIT_USERNAME=tu-usuario-github
GIT_TOKEN=tu-personal-access-token
